{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "installCommand": "npm ci --prefix bila",
  "buildCommand": "npm run build --prefix bila",
  "outputDirectory": "bila/dist/bila/browser",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
